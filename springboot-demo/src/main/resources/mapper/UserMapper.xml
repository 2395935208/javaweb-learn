<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootdemo.mapper.UserMapper">
    <resultMap id="userResultMap"
               type="com.example.springbootdemo.entity.User">
               <id column="id" property="id" />
    <result column="username" property="username" />
    <result column="age" property="age" />
    </resultMap>

    <!-- 根据多个ID批量查询用户 -->
    <select id="selectByIds" resultMap="userResultMap">
        SELECT id, username, age
        FROM `user`
        WHERE id IN
        <foreach collection="ids"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>
        ORDER BY id ASC
    </select>

    <select id="selectById"
            resultMap="userResultMap">
        SELECT id, username, age
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="search"
            resultType="com.example.springbootdemo.entity.User">
        SELECT id, username, age
        FROM `user`

        <where>
            <if test="keyword !=null and keyword != ''">
                AND username LIKE CONCAT('%', #{keyword}, '%')

            </if>

            <if test="minAge !=null">
                AND age>= #{minAge}
            </if>
        </where>

        ORDER BY id ASC
    </select>

    <select id="selectPage"
            resultType="com.example.springbootdemo.entity.User">
        SELECT id, username, age
        FROM `user`
        ORDER BY id ASC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="count"
            resultType="long">
        SELECT COUNT(*)
        FROM `user`
    </select>

    <select id="selectUserOrders"
            resultType="com.example.springbootdemo.dto.UserOrderDTO">
        SELECT
        u.id AS userId,
        u.username AS username,
        o.id AS orderId,
        o.product_name AS productName,
        o.amount AS amount
        FROM `user` u
        LEFT JOIN user_order o
        ON u.id = o.user_id
        ORDER BY u.id ASC, o.id ASC
    </select>
    <!-- 订单中嵌套用户对象的映射规则 -->
    <resultMap id="orderWithUserResultMap"
               type="com.example.springbootdemo.dto.OrderWithUserDTO">

        <!-- 外层：订单属性 -->
        <id column="order_id" property="orderId"/>
        <result column="product_name" property="productName"/>
        <result column="amount" property="amount"/>

        <!-- 内层：User对象 -->
        <association property="user"
                     javaType="com.example.springbootdemo.entity.User"
                     notNullColumn="user_id">

            <id column="user_id" property="id"/>
            <result column="username" property="username"/>
            <result column="age" property="age"/>
        </association>
    </resultMap>


    <!-- 查询订单，并把用户信息封装进订单的user属性 -->
    <select id="selectOrdersWithUser"
            resultMap="orderWithUserResultMap">
        SELECT
        o.id AS order_id,
        o.product_name AS product_name,
        o.amount AS amount,
        u.id AS user_id,
        u.username AS username,
        u.age AS age
        FROM user_order o
        LEFT JOIN `user` u
        ON o.user_id = u.id
        ORDER BY o.id ASC
    </select>
</mapper>